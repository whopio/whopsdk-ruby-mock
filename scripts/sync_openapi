#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
TARGET_PATH="${ROOT_DIR}/vendor/openapi/whop-openapi.yml"

# Same source as API reference docs and SDK generation
SOURCE_URL="https://app.stainless.com/api/spec/documented/whopsdk/openapi.documented.yml"

mkdir -p "$(dirname "${TARGET_PATH}")"

echo "Fetching OpenAPI spec from Stainless..."
echo "  ${SOURCE_URL}"

if ! curl -fsSL "${SOURCE_URL}" -o "${TARGET_PATH}"; then
  echo "Failed to fetch OpenAPI spec" >&2
  exit 1
fi

cat <<EOF

Synced OpenAPI spec from Stainless:
  source: ${SOURCE_URL}
  target: ${TARGET_PATH}
  size:   $(wc -c < "${TARGET_PATH}" | tr -d ' ') bytes

This is the same spec used for:
  - API reference docs (public-docs)
  - SDK generation (Stainless)
  - whop_mock (this repo)

Verification:
  bundle exec rspec
EOF
